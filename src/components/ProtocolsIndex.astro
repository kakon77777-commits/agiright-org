---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import ProtocolCard from './ProtocolCard.astro';
import { UI, type Lang, pick } from '../data/site';
import { PROTOCOLS, PROTOCOL_FAMILY_LABEL, AGENTIC_PAYMENT_NOTE, type Protocol } from '../data/protocols';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];

const title = pick({ en: 'Protocols', zh: '協議' }, lang);
const intro =
  pick({ en: 'Open drafts that form the rights layer of an AI-readable web: content & learning rights (AICR, AICL, AIRS, AILP) declare and license what AI may do with content; agent & protocol rights (AARS, AADP) declare what an Agent may do once it holds tool access, and who authorized it.', zh: '構成 AI 可讀網路權利層的開放草案:內容與學習權利(AICR、AICL、AIRS、AILP)宣告並授權 AI 可以對內容做什麼;Agent 與協議權利(AARS、AADP)宣告 Agent 一旦取得工具存取權後可以做什麼、以及是誰授權的。' }, lang);

const families: Protocol['family'][] = ['content', 'agent'];
---

<BaseLayout lang={lang} title={title} description={intro}>
  <PageHeader
    kicker={pick({ en: 'Protocol drafts', zh: '協議草案' }, lang)}
    title={title}
    intro={intro}
    badges={['Draft v0.1', 'Open specification experiment']}
  />
  <div class="container-site py-14 md:py-20">
    {
      families.map((family, i) => (
        <div class:list={[i > 0 && 'mt-14']}>
          <p class="spec-label !text-accent" data-reveal>{pick(PROTOCOL_FAMILY_LABEL[family], lang)}</p>
          <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
            {PROTOCOLS.filter((p) => p.family === family).map((p) => <ProtocolCard protocol={p} lang={lang} />)}
          </div>
        </div>
      ))
    }
    <div class="mt-10 rounded-md border-l-2 border-accent bg-accent-soft/50 px-5 py-4" data-reveal>
      <p class="spec-label !text-accent">Agentic Payment</p>
      <p class="mt-2 max-w-3xl text-[0.9rem] leading-relaxed text-ink-soft">{pick(AGENTIC_PAYMENT_NOTE, lang)}</p>
    </div>
    <p class="mt-10 max-w-3xl text-[0.85rem] leading-relaxed text-muted" data-reveal>
      {UI[lang].draftBanner}
    </p>
  </div>
</BaseLayout>
