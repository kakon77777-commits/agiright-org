---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import { langPrefix, type Lang, pick } from '../data/site';
import { PROTOCOLS } from '../data/protocols';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const prefix = langPrefix(lang);

const title = pick({ en: 'Machine-Readable Specs', zh: '機器可讀規範' }, lang);
const intro =
  pick({ en: 'Versioned specifications, JSON Schemas, and the policy files actually deployed on this site. Every file can be downloaded, validated, and cited directly.', zh: '所有協議的版本化規格、JSON Schema 與本站實際部署的政策檔。每個檔案都可直接下載、驗證與引用。' }, lang);

// Read at build time so the numbers shown here are exactly what the
// conformance scripts actually produced (scripts/conformance-check.mjs,
// terminology-lint.mjs, overclaim-lint.mjs) — never hand-typed.
const publicDir = fileURLToPath(new URL('../../public', import.meta.url));
const conformance = JSON.parse(readFileSync(`${publicDir}/ai/conformance-report.json`, 'utf8'));
const termLint = JSON.parse(readFileSync(`${publicDir}/ai/terminology-lint-report.json`, 'utf8'));
const overclaimLint = JSON.parse(readFileSync(`${publicDir}/ai/overclaim-lint-report.json`, 'utf8'));
const versionConsistency = JSON.parse(readFileSync(`${publicDir}/ai/version-consistency-report.json`, 'utf8'));
const dwrgValidation = JSON.parse(readFileSync(`${publicDir}/ai/dwrg-validation-report.json`, 'utf8'));

const integrationLayers = [
  {
    id: 'aicl-i',
    abbr: 'AICL-I',
    name: { en: 'AI Ingestion & Capability Layer', zh: 'AI 攝取與能力層' },
    status: 'Draft v0.2',
    page: '/docs/whitepapers/aicl-ai-ingestion-capability-layer',
    schema: '/schemas/aicl-i-runtime-decision.schema.json',
    note: {
      en: 'Runtime integration architecture -- not a seventh rights protocol. Orchestrates evaluation of the content-rights, action-rights, and authority decision planes around capability invocation.',
      zh: 'Runtime 整合架構——不是第七個權利協議。協調內容權利、行動權利、權力三個決策平面在能力調用前後的評估。',
    },
  },
];
const ethicalLayers = [
  {
    id: 'minimum-ethical-protection',
    name: { en: 'Minimum Ethical Protection', zh: 'AI 最小倫理保護' },
    status: 'Draft v0.1.1',
    page: '/docs/whitepapers/ai-minimum-ethical-protection',
    note: {
      en: 'A cross-layer ethical proposition, not a machine-enforceable protocol. v0.1.1 adds the Proportional Inspection Principle, operationalized through AADP\'s inspection_required/inspection_ceiling fields.',
      zh: '跨層倫理命題,不是可機器執行的協議。v0.1.1 新增比例檢查原則,透過 AADP 的 inspection_required/inspection_ceiling 欄位操作化。',
    },
  },
];

const liveFiles = [
  { path: '/llms.txt', desc: { en: 'Site guide for AI systems', zh: 'AI 系統的網站導覽' } },
  { path: '/robots.txt', desc: { en: 'Crawler access rules', zh: '爬蟲存取規則' } },
  { path: '/ai/manifest.json', desc: { en: 'AI-facing site manifest', zh: '面向 AI 的站點清單' } },
  { path: '/ai/rights-spectrum.json', desc: { en: 'AIRS spectrum declaration', zh: 'AIRS 光譜宣告' } },
  { path: '/ai/content-policy.json', desc: { en: 'Content policy summary', zh: '內容政策摘要' } },
  { path: '/ai/agent-actions.json', desc: { en: 'AARS agent-action declaration of this site', zh: '本站 AARS 行動宣告' } },
  { path: '/ai/agent-authority.json', desc: { en: 'AADP agent-authority declaration of this site', zh: '本站 AADP 權力宣告' } },
  { path: '/ai/inspection-policy.json', desc: { en: 'Proportional inspection policy (minimum necessary disclosure)', zh: '比例檢查政策(最小必要揭露)' } },
  { path: '/ai/runtime/policy.json', desc: { en: 'AICL-I v0.2 runtime-control pointer file', zh: 'AICL-I v0.2 runtime 控制指標檔' } },
  { path: '/ai/runtime/example-decision.json', desc: { en: 'Worked AICL-I runtime-decision object', zh: 'AICL-I runtime 決策物件範例' } },
  { path: '/ai/conformance-report.json', desc: { en: 'Generated C2 conformance test report (P1-P3/N1-N6)', zh: '產出的 C2 一致性測試報告' } },
  { path: '/ai/version-consistency-report.json', desc: { en: 'Cross-file protocol-version consistency report', zh: '跨檔案協議版本一致性報告' } },
  { path: '/resources', desc: { en: 'DWRG human-readable resource hub', zh: 'DWRG 人類可讀資源首頁' } },
  { path: '/resources.json', desc: { en: 'DWRG JSON resource registry projection', zh: 'DWRG JSON 資源 registry 投影' } },
  { path: '/resources.linkset.json', desc: { en: 'RFC 9264 Linkset projection of the same registry', zh: '同一 registry 的 RFC 9264 Linkset 投影' } },
  { path: '/ai/protocol-index.json', desc: { en: 'Protocol registry index', zh: '協議索引' } },
  { path: '/.well-known/aicr.json', desc: { en: 'AICR policy of this site', zh: '本站 AICR 政策' } },
  { path: '/.well-known/aicl.json', desc: { en: 'AICL license catalog of this site', zh: '本站 AICL 授權目錄' } },
  { path: '/.well-known/ai-rights.json', desc: { en: 'Combined rights entry point', zh: '整合權利入口' } },
  { path: '/.well-known/security.txt', desc: { en: 'Security contact', zh: '安全聯絡' } },
  { path: '/ai/registry.json', desc: { en: 'Protocol registry with version history', zh: '協議 registry(含版本歷史)' } },
  { path: '/ai/openapi.json', desc: { en: 'OpenAPI 3.1 — live demo API', zh: 'OpenAPI 3.1 — live demo API' } },
  { path: '/api/mock/402', desc: { en: 'Live AICL-style HTTP 402 mock endpoint', zh: 'AICL 式 HTTP 402 live mock 端點' } },
  { path: '/api/crawler-check?origin=https://agiright.org', desc: { en: 'Policy-surface inspector endpoint', zh: '政策層檢測端點' } },
  { path: '/downloads/agiright-policy-starter.zip', desc: { en: 'Deployable policy starter template', zh: '可部署的政策 starter 模板' } },
];
---

<BaseLayout lang={lang} title={title} description={intro}>
  <PageHeader kicker={pick({ en: 'Specifications', zh: '規範' }, lang)} title={title} intro={intro} badges={['Architecture v0.2']} />
  <div class="container-site py-14 md:py-20 space-y-16">
    <section>
      <h2 class="spec-label !text-accent" data-reveal>{pick({ en: 'Protocol specifications', zh: '協議規格' }, lang)}</h2>
      <div class="mt-6 overflow-hidden rounded-lg border border-line" data-reveal>
        <div class="hidden md:grid md:grid-cols-12 gap-4 bg-paper-deep px-5 py-3 border-b border-line">
          {[
            pick({ en: 'Protocol', zh: '協議' }, lang),
            pick({ en: 'Name', zh: '名稱' }, lang),
            pick({ en: 'Status', zh: '狀態' }, lang),
            'Schema',
          ].map((h, i) => (
            <p class:list={['spec-label', i === 0 && 'md:col-span-2', i === 1 && 'md:col-span-5', i === 2 && 'md:col-span-2', i === 3 && 'md:col-span-3']}>{h}</p>
          ))}
        </div>
        {
          PROTOCOLS.map((p, i) => (
            <div class:list={['grid grid-cols-1 gap-2 bg-surface px-5 py-4 md:grid-cols-12 md:items-center md:gap-4', i > 0 && 'border-t border-line']}>
              <a href={`${prefix}/protocols/${p.id}`} class="font-mono text-[0.95rem] font-medium text-navy hover:text-primary transition-colors duration-200 md:col-span-2">
                {p.abbr}
              </a>
              <p class="text-[0.88rem] text-ink-soft md:col-span-5">{pick(p.expansion, lang)}</p>
              <p class="md:col-span-2"><span class="badge badge-draft">{p.status}</span></p>
              <a href={p.schemaUrl} class="font-mono text-[0.78rem] text-spec hover:text-navy transition-colors duration-200 md:col-span-3" download>
                {p.schemaUrl.split('/').pop()} ↓
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="spec-label !text-accent" data-reveal>{pick({ en: 'Integration & ethical layers', zh: '整合與倫理層' }, lang)}</h2>
      <p class="mt-2 max-w-2xl text-[0.85rem] text-muted" data-reveal>
        {pick({ en: 'These sit alongside the six rights protocols but are not themselves rights protocols — one orchestrates evaluation across them, the other is a cross-layer ethical proposition.', zh: '這兩者與六個權利協議並列,但本身不是權利協議——一個負責協調評估,另一個是跨層的倫理命題。' }, lang)}
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2" data-reveal>
        {integrationLayers.map((l) => (
          <a href={`${prefix}${l.page}`} class="flex flex-col gap-2 rounded-lg border border-line bg-surface px-5 py-4 no-underline hover:bg-primary-soft/40 transition-colors duration-200">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[0.95rem] font-medium text-navy">{l.abbr}</span>
              <span class="badge badge-draft">{l.status}</span>
            </div>
            <p class="text-[0.85rem] text-ink-soft">{pick(l.name, lang)}</p>
            <p class="text-[0.78rem] text-muted">{pick(l.note, lang)}</p>
          </a>
        ))}
        {ethicalLayers.map((l) => (
          <a href={`${prefix}${l.page}`} class="flex flex-col gap-2 rounded-lg border border-line bg-surface px-5 py-4 no-underline hover:bg-primary-soft/40 transition-colors duration-200">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[0.82rem] font-medium text-navy">{pick(l.name, lang)}</span>
              <span class="badge badge-draft">{l.status}</span>
            </div>
            <p class="text-[0.78rem] text-muted">{pick(l.note, lang)}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="spec-label !text-accent" data-reveal>{pick({ en: 'Conformance', zh: '一致性驗收' }, lang)}</h2>
      <p class="mt-2 max-w-2xl text-[0.85rem] text-muted" data-reveal>
        {pick({ en: 'Generated by running scripts/conformance-check.mjs against the Integration Conformance Profile\'s own required test cases — this is a decision-logic simulation of the AICL-I runtime model, not a claim that every live endpoint executes this exact code path.', zh: '由執行 scripts/conformance-check.mjs 對照整合一致性驗收規格自身要求的測試案例產出——這是 AICL-I runtime 模型的決策邏輯模擬,不代表本站每個 live 端點都執行這條確切的程式路徑。' }, lang)}
      </p>
      <div class="mt-6 rounded-lg border border-line bg-surface px-5 py-4" data-reveal>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <p class="text-[0.85rem]">
            <span class="font-mono font-medium text-navy">{conformance.conformance_level_target}</span>
            {' '}{pick({ en: 'target level', zh: '目標等級' }, lang)}
          </p>
          <p class="text-[0.85rem]">
            <span class:list={['font-mono font-medium', conformance.all_pass ? 'text-primary' : 'text-accent']}>{conformance.cases_passed}/{conformance.cases_total}</span>
            {' '}{pick({ en: 'test cases pass', zh: '測試案例通過' }, lang)}
          </p>
          <p class="text-[0.85rem]">
            <span class:list={['font-mono font-medium', conformance.shortcuts_rejected === conformance.shortcuts_total ? 'text-primary' : 'text-accent']}>{conformance.shortcuts_rejected}/{conformance.shortcuts_total}</span>
            {' '}{pick({ en: 'unsafe shortcuts rejected', zh: '不安全捷徑被拒絕' }, lang)}
          </p>
        </div>
        <div class="mt-4 grid grid-cols-1 gap-1 sm:grid-cols-3">
          {conformance.cases.map((c: { id: string; name: string; pass: boolean }) => (
            <p class="flex items-center gap-2 text-[0.78rem] text-ink-soft">
              <span class:list={['font-mono text-[0.7rem]', c.pass ? 'text-primary' : 'text-accent']}>{c.pass ? '✓' : '✗'}</span>
              <span class="font-mono">{c.id}</span>
              <span class="truncate">{c.name}</span>
            </p>
          ))}
        </div>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-1 border-t border-line pt-4 text-[0.78rem] text-muted">
          <p>
            {pick({ en: 'Terminology lint', zh: '術語一致性檢查' }, lang)}:{' '}
            <span class="font-mono">{termLint.status}</span>{' '}
            ({termLint.ambiguities_found} {pick({ en: 'flagged, all reviewed — see report', zh: '項標記,均已審閱——見報告' }, lang)})
          </p>
          <p>
            {pick({ en: 'False-standard-claim lint', zh: '虛假標準宣稱檢查' }, lang)}:{' '}
            <span class="font-mono">{overclaimLint.status}</span>{' '}
            ({overclaimLint.authorial_candidates_found} {pick({ en: 'checked, 0 overclaims', zh: '項已查核,0 項誇大宣稱' }, lang)})
          </p>
          <p>
            {pick({ en: 'Version-consistency check', zh: '版本一致性檢查' }, lang)}:{' '}
            <span class:list={['font-mono', versionConsistency.status === 'PASS' ? 'text-primary' : 'text-accent']}>{versionConsistency.status}</span>{' '}
            ({versionConsistency.checks_run} {pick({ en: 'cross-file checks, 0 mismatches', zh: '項跨檔案檢查,0 項不一致' }, lang)})
          </p>
          <p>
            {pick({ en: 'DWRG validation', zh: 'DWRG 驗證' }, lang)}:{' '}
            <span class:list={['font-mono', dwrgValidation.status === 'PASS' ? 'text-primary' : 'text-accent']}>{dwrgValidation.status}</span>{' '}
            ({dwrgValidation.resources_checked} {pick({ en: 'resources, 0 findings', zh: '項資源,0 項問題' }, lang)})
          </p>
        </div>
        <a href="/ai/conformance-report.json" class="mt-4 inline-block font-mono text-[0.78rem] text-spec hover:text-navy transition-colors duration-200" download>
          conformance-report.json ↓
        </a>
      </div>
    </section>

    <section>
      <h2 class="spec-label !text-accent" data-reveal>{pick({ en: 'Files deployed on this site', zh: '本站部署的檔案' }, lang)}</h2>
      <div class="mt-6 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2" data-reveal>
        {
          liveFiles.map((f) => (
            <a href={f.path} class="group flex flex-col gap-1 bg-surface p-4.5 px-5 py-4 no-underline cursor-pointer hover:bg-primary-soft/40 transition-colors duration-200">
              <span class="font-mono text-[0.82rem] font-medium text-spec group-hover:text-navy transition-colors duration-200">{f.path}</span>
              <span class="text-[0.8rem] text-muted">{pick(f.desc, lang)}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="rounded-md border-l-2 border-line-strong bg-surface px-5 py-4" data-reveal>
      <p class="spec-label">{pick({ en: 'Versioning', zh: '版本策略' }, lang)}</p>
      <p class="mt-2 max-w-3xl text-[0.9rem] leading-relaxed text-ink-soft">
        {pick({ en: 'Specs are labeled Draft → Experimental → Proposal → Stable; everything here is currently Draft (AICR/AICL/AIRS/AILP at v0.1.1, AARS/AADP at v0.1, AICL-I at v0.2, Minimum Ethical Protection at v0.1.1). Fields and semantics may change before v1.0; breaking changes will be recorded in a changelog. None are adopted industry or legal standards.', zh: '規格以 Draft → Experimental → Proposal → Stable 標示狀態;目前全部為 Draft(AICR/AICL/AIRS/AILP 為 v0.1.1,AARS/AADP 為 v0.1,AICL-I 為 v0.2,AI 最小倫理保護為 v0.1.1)。欄位與語意在 v1.0 前可能變動,重大變更會記錄於 changelog。皆非業界或法律採納的標準。' }, lang)}
      </p>
    </section>
  </div>
</BaseLayout>
