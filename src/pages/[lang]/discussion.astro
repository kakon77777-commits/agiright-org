---
import DiscussionPage from '../../components/DiscussionPage.astro';
import { NON_DEFAULT_LANGS, type Lang } from '../../data/site';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<DiscussionPage lang={lang} />
